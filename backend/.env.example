PORT=5000
OPENAI_API_KEY=your_openai_api_key_here
# Set this to the frontend origin you are using: 5173, 5174, or another local port.
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
BUREAU_MODE=demo
BUREAU_API_URL=https://your-bureau-api.example.com/cibil-score
BUREAU_API_KEY=your_bureau_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
TWILIO_FROM_NUMBER=+1234567890
# Google OAuth (set these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# The redirect URI the Google OAuth flow will use when exchanging the code (frontend origin is typical)
GOOGLE_REDIRECT_URI=http://localhost:5173
